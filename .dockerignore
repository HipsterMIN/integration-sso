# ══════════════════════════════════════════════════════════════════════════════
# .dockerignore — Docker 빌드 컨텍스트 최적화
# S8-T6: 불필요한 파일 제외로 빌드 속도 및 이미지 크기 개선
# ══════════════════════════════════════════════════════════════════════════════

# ── 버전 관리 ───────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── 빌드 산출물 (빌더 스테이지가 재생성) ─────────────────────────────────────
**/build/
**/out/
**/target/
**/.gradle/
**/gradle-cache/

# ── 개발 도구 설정 ────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
*.code-workspace
.editorconfig

# ── 테스트 리포트 및 커버리지 ──────────────────────────────────────────────────
**/reports/
**/test-results/
**/jacoco/

# ── OS 메타데이터 ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── 로그 및 임시 파일 ────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*~

# ── 문서 (런타임 불필요) ─────────────────────────────────────────────────────
docs/
*.md
!README.md

# ── CI/CD 설정 (런타임 불필요) ─────────────────────────────────────────────
.github/
infra/docker/

# ── k6 부하 테스트 (런타임 불필요) ────────────────────────────────────────────
k6/

# ── FE 소스 (Spring Boot 서버 빌드 불필요) ─────────────────────────────────
onepass-fe/

# ── Node.js 의존성 ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
*.lock

# ── 환경 변수 파일 (보안 민감 — 빌드 컨텍스트 제외) ────────────────────────────
.env
.env.*
*.env

# ── Gradle 로컬 캐시 (BuildKit 캐시 마운트 사용) ─────────────────────────────
.gradle/

# ── Docker 관련 파일 자체 ────────────────────────────────────────────────────
docker-compose*.yml
Dockerfile*
.dockerignore
