# Onepass FE 환경변수 설정 예시
# 실제 개발 시 .env.local 또는 .env 파일로 복사하여 사용

# ── IdO 게이트웨이 (FE 의 유일한 외부 호출 대상; ADR-008) ────────────────────
# Phase 2 / SEC-IDO-01..03: 구 BE_API_* → IDO_API_* 로 rename.
# 코드는 IDO_API_* 우선 사용, 없으면 구 BE_API_* fallback (호환 기간 유지).

# IdO API 엔드포인트 — 빈 값이면 webpack devServer proxy 가 IDO_API_TARGET 으로 라우팅
IDEM_HUB_API_ENDPOINT=
# webpack devServer proxy 타겟 (dev only)
IDO_API_TARGET=https://onepass-ido-dev.smes.go.kr
# FE → IdO 식별 키 (X-Internal-Api-Key 헤더로 송신; FE 번들 노출 — IdO 가 origin/CORS/Rate-Limit 로 방어)
IDEM_HUB_API_KEY=replace-with-issued-ido-api-key

# Option B: 개발서버 → BFF 프록시 타겟
# webpack.config.js 의 devServer.proxy 에서 localhost:8080 로 직접 지정됨

# BFF API 베이스 (런타임에 window 주입 또는 webpack DefinePlugin 활용)
REACT_APP_API_BASE_URL=http://localhost:8080

# IdO 기반 Handoff 리다이렉트 기준 (개발)
REACT_APP_IDO_BASE_URL=http://localhost:8083

# 앱 표시명
REACT_APP_NAME=OnePass 통합인증
REACT_APP_VERSION=1.0.0
