##############################################################################
# Tomcat 10.1 + JDK 17 테스트베드
# Servlet 6.0 (Jakarta EE 10 — jakarta.servlet 네임스페이스)
# Spring Boot 3.x 임베디드 Tomcat과 동일한 환경
##############################################################################
FROM eclipse-temurin:17-jre-jammy

LABEL description="OnePass Agent Testbed - Tomcat 10.1 + JDK 17 (Jakarta EE)"

ENV TOMCAT_VERSION=10.1.18
ENV TOMCAT_HOME=/usr/local/tomcat
ENV CATALINA_HOME=/usr/local/tomcat

RUN apt-get update && apt-get install -y curl wget && rm -rf /var/lib/apt/lists/*

RUN wget -q https://archive.apache.org/dist/tomcat/tomcat-10/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz \
    -O /tmp/tomcat.tar.gz \
    && mkdir -p ${TOMCAT_HOME} \
    && tar -xzf /tmp/tomcat.tar.gz -C ${TOMCAT_HOME} --strip-components=1 \
    && rm /tmp/tomcat.tar.gz \
    && chmod +x ${TOMCAT_HOME}/bin/*.sh

VOLUME ["/agent", "/agent-config"]

# jakarta.servlet.Filter 위빙 전용 (javax 없음!)
ENV JAVA_OPTS="-javaagent:/agent/idem-agent-all.jar=/agent-config/onepass-agent.properties \
    -Donepass.was.type=TOMCAT_10_PLUS \
    -Xms256m -Xmx512m \
    -XX:+UseG1GC"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

WORKDIR ${TOMCAT_HOME}
CMD ["bin/catalina.sh", "run"]
