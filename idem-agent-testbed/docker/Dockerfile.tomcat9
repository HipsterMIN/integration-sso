##############################################################################
# Tomcat 9.0 + JDK 11 테스트베드
# Servlet 4.0 (javax 네임스페이스 마지막 버전)
# 공공기관에서 가장 많이 사용되는 환경 중 하나
##############################################################################
FROM eclipse-temurin:11-jre-jammy

LABEL maintainer="OnePass Team <onepass@smes.go.kr>"
LABEL description="OnePass Agent Testbed - Tomcat 9 + JDK 11"

# Tomcat 9.0 최신 버전 설치
ENV TOMCAT_VERSION=9.0.85
ENV TOMCAT_HOME=/usr/local/tomcat
ENV CATALINA_HOME=/usr/local/tomcat
ENV CATALINA_BASE=/usr/local/tomcat

RUN apt-get update && apt-get install -y curl wget && rm -rf /var/lib/apt/lists/*

RUN wget -q https://archive.apache.org/dist/tomcat/tomcat-9/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz \
    -O /tmp/tomcat.tar.gz \
    && mkdir -p ${TOMCAT_HOME} \
    && tar -xzf /tmp/tomcat.tar.gz -C ${TOMCAT_HOME} --strip-components=1 \
    && rm /tmp/tomcat.tar.gz \
    && chmod +x ${TOMCAT_HOME}/bin/*.sh

# Agent JAR 마운트 포인트
VOLUME ["/agent", "/agent-config", "/webapps-custom"]

# 기본 샘플 웹앱 복사 위치
RUN mkdir -p ${TOMCAT_HOME}/webapps/sample

# Tomcat 서버 설정 최적화
COPY tomcat-config/server.xml ${TOMCAT_HOME}/conf/server.xml
COPY tomcat-config/context.xml ${TOMCAT_HOME}/conf/context.xml

# Agent JAR + 설정 경로 (docker-compose에서 볼륨 마운트)
ENV JAVA_OPTS="-javaagent:/agent/idem-agent-all.jar=/agent-config/onepass-agent.properties \
    -Donepass.was.type=TOMCAT_9 \
    -Xms256m -Xmx512m \
    -XX:+UseG1GC \
    -Djava.awt.headless=true"

EXPOSE 8080 8443

# 건강 체크용 스크립트 복사
COPY scripts/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/healthcheck.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

WORKDIR ${TOMCAT_HOME}
CMD ["bin/catalina.sh", "run"]
