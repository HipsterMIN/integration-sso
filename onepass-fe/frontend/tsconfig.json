{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": "src",
    "paths": {
      "@/*":          ["*"],
      "@api/*":       ["api/*"],
      "@components/*":["components/*"],
      "@pages/*":     ["pages/*"],
      "@hooks/*":     ["hooks/*"],
      "@store/*":     ["store/*"],
      "@types/*":     ["types/*"],
      "@utils/*":     ["utils/*"],
      "@styles/*":    ["styles/*"],
      "@constants/*": ["constants/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
