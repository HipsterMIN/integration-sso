<!DOCTYPE html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			http-equiv="Cache-Control"
			content="no-cache, no-store, must-revalidate, max-age: 0"
		/>
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="Expires" content="0" />

		<title data-react-helmet="true">중기원패스 통합회원</title>
		<meta
			data-react-helmet="true"
			property="og:title"
			content="중기원패스 통합회원"
		/>
		<meta
			data-react-helmet="true"
			name="description"
			content="하나의 아이디로 중소벤처기업부 유관기관의 서비스를 모두 이용해 보세요. 중소기업기술정보진흥원이 운영하는 통합로그인 서비스입니다."
		/>
		<meta
			data-react-helmet="true"
			property="og:description"
			content="하나의 아이디로 중소벤처기업부 유관기관의 서비스를 모두 이용해 보세요. 중소기업기술정보진흥원이 운영하는 통합로그인 서비스입니다."
		/>
		<meta data-react-helmet="true" property="og:type" content="website" />
		<meta data-react-helmet="true" property="og:site_name" content="중기원패스 통합회원" />
		<meta name="robots" content="noindex" />
		<meta name="format-detection" content="telephone=no" />

		<link data-react-helmet="true" rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link data-react-helmet="true" rel="shortcut icon" href="/favicon.ico" />
		<link data-react-helmet="true" rel="apple-touch-icon" sizes="192x192" href="/logo192.png" />
		<link rel="manifest" href="/manifest.json" />

		<!-- EzAuth 간편인증 SDK (드림시큐리티) -->
		<script src="/ezauth/js/EzAuth.bundle.js"></script>

		<!-- Any-ID 정부 통합인증 SDK (행안부) -->
		<!-- /anyid/* 경로는 webpack devServer proxy → ido(8083) 에서 서빙됨 -->
		<!-- 운영: nginx/Spring Boot static에서 서빙 -->
		<link rel="stylesheet" href="/anyid/css/app.css">
		<script defer src="/anyid/js/manifest.js"></script>
		<script defer src="/anyid/js/vendor.js"></script>
		<script defer src="/anyid/js/app.js"></script>
	</head>
	<body class="onepass-ui">
		<noscript>이 앱을 사용하려면 JavaScript를 활성화해야 합니다.</noscript>
		<div id="root"></div>
	</body>
</html>
