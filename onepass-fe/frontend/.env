# ── OnePass FE 환경 변수 (로컬 통합 개발용) ──────────────────────────────
# 이 파일은 webpack.config.js에서 dotenv로 로드됨

# Frontend API Endpoint (빈 값 = webpack proxy 사용)
FRONTEND_API_ENDPOINT=

# IdO API (onepass-ido) — 로컬: webpack proxy → 8083, 개발서버: https://onepass-ido-dev.smes.go.kr
# Phase 2 / SEC-IDO-01..03 (ADR-008): 구 BE_API_* 변수명 → IDO_API_* 로 rename.
# 코드는 IDO_API_* 우선 사용, 없으면 BE_API_* fallback (한 페이즈 호환 유지).
IDO_API_ENDPOINT=
IDO_API_TARGET=https://onepass-ido-dev.smes.go.kr
IDO_API_KEY=bek-6d1816b0cd5bc5a5a1d3429063c58b99

# EXT API (Q-IM, 외부 연동)
EXT_API_ENDPOINT=
EXT_API_KEY="imk-7ddb59c9deea699c55efa93b6925d6d9"

# WebSocket API Endpoint
WEBSOCKET_API_ENDPOINT=

# 인증 스킵 (개발용 true, 운영 false)
SKIP_AUTH=true

# Q-Sign (Keycloak) 설정 - 로컬 (현재 미사용)
# QSIGN_BASE_URL=http://192.168.1.11:9090
# QSIGN_REALM=sso-test
# QSIGN_CLIENT_ID=platform

# AES-256-GCM 키 (Q-IM CI 암호화용, base64 32바이트)
AES_GCM_KEY=DL5vnfsm01CfLlycU6k8NvCDy3tpO5/MXMuqV0uMCv8=

# 간편인증 (EasySign)
EASYSIGN_URL=https://easysign.anyid.go.kr/esign
EASYSIGN_ORIGIN=https://easysign.anyid.go.kr

# Grafana Faro
FARO_COLLECTOR_URL=/faro/collect
FARO_TENANT_ID=

# Sentry (운영에서만 활성화)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_ID=
# SENTRY_DSN=
# TUNNEL_URL=
# TUNNEL_DOMAIN=
