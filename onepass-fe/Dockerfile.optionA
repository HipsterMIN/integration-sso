# ══════════════════════════════════════════════════════════════════════════════
# Option A — React 빌드 산출물을 ido JAR 의 정적 리소스로 포함 (단일 JAR 배포)
#
# [변경] onepass-fe Spring Boot BFF 제거
#   React 빌드 산출물을 ido(BFF) 정적 리소스에 포함시켜 단일 JAR 로 배포.
#   BFF API 는 ido /api/v1/fe-session/** 에서 제공.
#
# 빌드 명령:
#   docker build -f onepass-fe/Dockerfile.optionA -t onepass-ido:latest .
#
# 실행:
#   docker run -p 8083:8083 onepass-ido:latest
# ══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: React 빌드 ──────────────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder
WORKDIR /frontend
COPY onepass-fe/frontend/package.json onepass-fe/frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile --network-timeout 120000
COPY onepass-fe/frontend/ .
RUN yarn build:prod

# ── Stage 2: Gradle + Java 빌드 (ido) ───────────────────────────────────────
FROM eclipse-temurin:21-jdk-alpine AS backend-builder
WORKDIR /build

# React 빌드 산출물을 ido 정적 리소스 위치로 복사
# ido 가 SpaController 또는 Nginx-equivalent 로 index.html 서빙
COPY --from=frontend-builder /frontend/dist \
     /build/ido/src/main/resources/static

# Gradle 빌드
COPY gradle/              gradle/
COPY gradlew              gradlew
COPY settings.gradle.kts  .
COPY build.gradle.kts     .
COPY platform-common/     platform-common/
COPY q-sign/              q-sign/
COPY q-im/                q-im/
COPY ido/                 ido/
COPY onepass-fe/          onepass-fe/
COPY agency-stub/         agency-stub/

RUN chmod +x gradlew && \
    ./gradlew :ido:bootJar -x test --no-daemon

# ── Stage 3: 런타임 ──────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-alpine AS runtime
WORKDIR /app

# 비루트 사용자
RUN addgroup -S smes && adduser -S smes -G smes
USER smes

COPY --from=backend-builder /build/ido/build/libs/*-SNAPSHOT.jar app.jar

EXPOSE 8083

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
