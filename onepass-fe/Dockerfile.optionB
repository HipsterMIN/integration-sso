# ══════════════════════════════════════════════════════════════════════════════
# Option B — React + Nginx (독립 서비스)
#
# build context: 프로젝트 루트 (infra/docker/nginx/nginx.conf 참조 필요)
#
# 빌드 명령 (프로젝트 루트에서):
#   docker build \
#     -f onepass-fe/Dockerfile.optionB \
#     -t onepass-react:latest \
#     --target react-nginx \
#     .
#
# Docker Compose 사용 시 (infra/docker/docker-compose.yml):
#   context: ../..                    ← 프로젝트 루트
#   dockerfile: onepass-fe/Dockerfile.optionB
#
# 실행:
#   docker run -p 3001:80 onepass-react:latest
# ══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: React 빌드 ──────────────────────────────────────────────────────
FROM node:20-alpine AS react-builder
WORKDIR /app

# package.json / yarn.lock만 먼저 복사 → yarn install 레이어 캐시 활용
COPY onepass-fe/frontend/package.json onepass-fe/frontend/yarn.lock* ./
RUN yarn install --frozen-lockfile --network-timeout 120000

# 소스 전체 복사 후 빌드
COPY onepass-fe/frontend/ .
RUN yarn build:prod

# ── Stage 2: Nginx 서빙 ──────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS react-nginx
LABEL maintainer="kr.go.smes"
LABEL description="OnePass React Frontend (Option B — Nginx)"

# React 빌드 산출물 복사
COPY --from=react-builder /app/dist /usr/share/nginx/html

# Nginx 설정 (프로젝트 루트 context 기준 경로)
COPY infra/docker/nginx/nginx.conf /etc/nginx/nginx.conf

# 헬스체크
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -qO- http://localhost/nginx-health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
