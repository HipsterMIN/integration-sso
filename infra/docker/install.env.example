# Idem 단일 설치본 환경 파일 — docs/install.md
#   cp infra/docker/install.env.example infra/docker/install.env
#   아래 "생성" 표시 값은 반드시 새로 만든다:  openssl rand -base64 32  /  openssl rand -hex 32
# install.env 는 커밋하지 않는다 (.gitignore).

# ── 데이터 ────────────────────────────────────────────────────────────────
IDEM_DB_PASSWORD=            # 생성 (PostgreSQL onepass 사용자 · Keycloak · 모든 앱이 같이 쓴다)
KEYCLOAK_ADMIN_PASSWORD=     # 생성 (Keycloak 관리 콘솔 admin — 설치자만 사용, 기관에는 노출하지 않는다)

# ── 서비스 간 인증 ────────────────────────────────────────────────────────
IDO_INTERNAL_SIG_SECRET=     # 생성 (base64 32바이트) gate ↔ hub 내부 서명
IDO_INTERNAL_API_KEY_QSIGN=  # 생성 (hex 32) hub 내부 호출자 키 — gate
IDO_INTERNAL_API_KEY_OUTBOX= # 생성 (hex 32) hub 내부 호출자 키 — 릴레이
QIM_INTERNAL_API_KEY=        # 생성 (hex 32) hub → registry
AUTHZ_INTERNAL_API_KEY=      # 생성 (hex 32) hub → authz (비우면 authz 내부 API 비활성)

# ── Keycloak client secret (realm import 와 앱이 같은 값을 읽는다) ─────────
QSIGN_KEYCLOAK_CLIENT_SECRET=  # 생성 (hex 32) q-sign-client
KEYCLOAK_CLIENT_SECRET=        # 생성 (hex 32) ido-client

# ── Handoff / Webhook 키 ─────────────────────────────────────────────────
IDO_HANDOFF_AES_KEY=         # 생성 (base64 32바이트) Handoff 티켓 AES-256-GCM
IDO_HANDOFF_HMAC_KEY=        # 생성 (base64 32바이트) Handoff 티켓 HMAC-SHA256
IDO_WEBHOOK_SIGNING_SECRET=  # 생성 (hex 32) 기관 웹훅 서명

# ── 선택: 공개 URL·포트 (브라우저가 접근하는 주소. 리버스 프록시 뒤라면 그 주소) ──
#IDEM_PUBLIC_URL_HUB=http://localhost:8083
#IDEM_PUBLIC_URL_GATE=http://localhost:8081
#IDEM_PUBLIC_URL_CONSOLE=http://localhost:3001
#IDEM_PORT_HUB=8083
#IDEM_PORT_GATE=8081
#IDEM_PORT_REGISTRY=8082
#IDEM_PORT_AUTHZ=8086
#IDEM_PORT_CONSOLE=3001
#IDEM_PORT_KEYCLOAK=8088
#IDEM_PORT_POSTGRES=5432
#IDEM_TZ=Asia/Seoul
#IDEM_VERSION=latest

# ── 선택: 설치 검증 ───────────────────────────────────────────────────────
# 벤더 플러그인 없이 로그인 흐름을 확인하는 Mock 본인확인 제공자. 검증 후 반드시 false.
IDEM_PLUGINS_MOCK_AUTH_ENABLED=false
# hub 브로커 모드: qsign(기본, 본인확인 SPI 경로) | keycloak(표준 OIDC 로그인)
#IDO_BROKER_MODE=qsign
