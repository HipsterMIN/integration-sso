# ============================================================
# MariaDB 11.x PoC 설정
# Q-IM 전용 (NHN Cloud RDS for MariaDB 운영 환경과 동일한 파라미터 기준)
#
# NHN Cloud RDS for MariaDB 주요 기본값과 일치시킨 항목:
#   - character-set: utf8mb4
#   - collation: utf8mb4_unicode_ci
#   - innodb_buffer_pool_size: 운영 RDS는 인스턴스 사양에 따라 자동 설정
#     → 로컬 PoC: 512MB 고정
#   - time_zone: UTC  (애플리케이션 UTC 저장 기준과 일치)
#   - slow_query_log: ON (쿼리 튜닝용)
# ============================================================

[mysqld]

# ── 문자셋 ─────────────────────────────────────────────────────
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci
character_set_client  = utf8mb4

# ── 타임존 ─────────────────────────────────────────────────────
# 앱 레벨 UTC 보장 (application.yml serverTimezone=UTC 와 일치)
default-time-zone     = '+00:00'

# ── InnoDB 스토리지 엔진 ────────────────────────────────────────
default-storage-engine     = InnoDB
innodb_buffer_pool_size    = 512M       # 로컬 PoC 기준 (운영 RDS: 자동)
innodb_log_file_size       = 128M
innodb_flush_log_at_trx_commit = 1      # ACID 보장 (운영 동일)
innodb_file_per_table      = 1
innodb_strict_mode         = 1

# ── 연결 ────────────────────────────────────────────────────────
max_connections            = 200
max_allowed_packet         = 64M
connect_timeout            = 10
wait_timeout               = 600
interactive_timeout        = 600

# ── 슬로우 쿼리 로그 ─────────────────────────────────────────────
slow_query_log             = 1
slow_query_log_file        = /var/lib/mysql/slow.log
long_query_time            = 1.0

# ── 바이너리 로그 (운영 RDS 복제 대비 — PoC는 비활성) ──────────────
# 운영 NHN RDS: binlog 자동 활성화됨
# 로컬 PoC: 명시적 비활성 (용량 절약)
skip-log-bin

# ── SQL 모드 (NHN RDS 기본값과 일치) ─────────────────────────────
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ── JSON 지원 (MariaDB 10.2+) ────────────────────────────────────
# JSON 타입 칼럼 사용 (V1 migration: di_map, extra_attributes, payload)
# 별도 설정 불필요 — InnoDB 기본 지원

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
