# ══════════════════════════════════════════════════════════════════════════════
# OnePass Platform — 모니터링 스택 환경 변수 예시
# S8-T7: Grafana 알림 채널 설정
#
# 사용 방법:
#   cp infra/docker/.env.monitoring.example infra/docker/.env.monitoring
#   # 실제 값으로 수정 후:
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml \
#     --env-file .env.monitoring up -d
#
# 주의: .env.monitoring 파일은 .gitignore에 등록하여 커밋하지 마세요.
# ══════════════════════════════════════════════════════════════════════════════

# ── Grafana 보안 ──────────────────────────────────────────────────────────────
GF_SECRET_KEY=change-me-secret-key-32bytes-here!!

# ── SMTP (이메일 알림) ────────────────────────────────────────────────────────
# 이메일 알림 활성화 여부 (true/false)
GF_SMTP_ENABLED=true

# SMTP 서버 주소:포트
# Gmail: smtp.gmail.com:587
# Naver: smtp.naver.com:587
# 사내 SMTP: mail.smes.go.kr:587
SMTP_HOST=smtp.gmail.com:587

# SMTP 계정 (발신 계정)
SMTP_USER=alert@smes.go.kr

# SMTP 비밀번호 (Gmail: 앱 비밀번호 사용 권장)
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-smtp-app-password

# 발신 이메일 주소 (수신자에게 보이는 From 주소)
ALERT_EMAIL_FROM=alert@smes.go.kr

# 수신 이메일 주소 (콤마로 여러 명 지정 가능)
ALERT_EMAIL_TO=oncall@smes.go.kr,team-lead@smes.go.kr

# ── Slack (알림 채널) ─────────────────────────────────────────────────────────
# Slack Incoming Webhook URL
# 발급: https://api.slack.com/messaging/webhooks
# Apps → Create an App → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# 긴급 알림 채널 (CRITICAL severity — 서비스 다운, 오류율 급증)
SLACK_CRITICAL_CHANNEL=#onepass-alerts-critical

# 경고 알림 채널 (WARNING severity — P95 지연, Rate Limit 급증)
SLACK_WARNING_CHANNEL=#onepass-alerts
