# ============================================================
# 통합인증 플랫폼 — Docker Compose 환경변수 예시
# ============================================================
#
# 사용법:
#   cp infra/docker/.env.example infra/docker/.env
#   vi infra/docker/.env   ← 운영 값으로 교체 후 사용
#
# [보안 규칙]
#   - .env 파일은 .gitignore에 등록되어 있으며 절대 커밋하지 않는다
#   - *_SECRET, *_KEY, *_PASSWORD 값은 운영 전 반드시 교체한다
#   - 운영 배포 시 K8s Secret 또는 Vault에서 주입한다
#   - 기본값(change-me, AAAA...)은 PoC 전용이다
#
# [키 생성 명령]
#   32바이트 랜덤 hex : openssl rand -hex 32
#   32바이트 base64   : openssl rand -base64 32
#   AES-256 키(32B)  : openssl rand -base64 32 | head -c 44 (base64 패딩 포함)
#
# ============================================================


# ────────────────────────────────────────────────────────────
# [1] Q-IM 내부 API 키 — IdO → Q-IM 호출 인증
# ────────────────────────────────────────────────────────────
# q-im 서비스는 이 값을 QIM_INTERNAL_API_KEY 로 수신하고
# ido 서비스는 이 값을 IDO_QIM_INTERNAL_API_KEY 로 Q-IM 호출 시 헤더(X-Internal-Api-Key)에 사용한다.
# 두 서비스에 동일한 값이 주입되어야 한다.
#
# 운영: 최소 32자 이상 무작위 문자열 (openssl rand -hex 32)
# 형식: 영문+숫자+특수문자, 길이 32~64자
QIM_INTERNAL_API_KEY=dev-qim-internal-api-key-change-me-before-production

# ────────────────────────────────────────────────────────────
# [2] Keycloak Client Secret
# ────────────────────────────────────────────────────────────
# q-sign → q-sign-client 용 Keycloak Client Secret
# ※ infra/docker/keycloak/realm-export.json 의 q-sign-client.secret 과 반드시 동일해야 함
# 운영: Keycloak Admin Console > Clients > q-sign-client > Credentials에서 재생성
QSIGN_KEYCLOAK_CLIENT_SECRET=change-me

# IdO → ido-client 용 Keycloak Client Secret
# ※ infra/docker/keycloak/realm-export.json 의 ido-client.secret 과 반드시 동일해야 함
# 운영: Keycloak Admin Console > Clients > ido-client > Credentials에서 재생성
KEYCLOAK_CLIENT_SECRET=change-me

# ────────────────────────────────────────────────────────────
# [3] IdO 내부 서명 비밀키 (Q-Sign ↔ IdO X-Internal-Sig HMAC-SHA256)
# ────────────────────────────────────────────────────────────
# q-sign과 ido 양쪽에 동일한 값이 주입되어야 한다.
# 운영: openssl rand -hex 32 (최소 32자)
IDO_INTERNAL_SIG_SECRET=change-me-32bytes-internal-sig-secret

# ────────────────────────────────────────────────────────────
# [4] Handoff 암호화 키 (AES-256-GCM + HMAC-SHA256)
# ────────────────────────────────────────────────────────────
# 운영: openssl rand -base64 32 (32바이트, base64 인코딩)
# 주의: key rotation 정책에 따라 90일마다 교체 + 24시간 유예기간
IDO_HANDOFF_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IDO_HANDOFF_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ────────────────────────────────────────────────────────────
# [4-1] KMS(Key Management Service) 설정
# ────────────────────────────────────────────────────────────
# IDO_KMS_ENABLED: KMS On/Off 스위치
#   false (기본) → LocalKmsClient 활성화: KMS 서버 없이 개발 가능 (Base64 패스스루)
#   true         → IDO_KMS_PROVIDER 값의 실제 KMS 클라이언트 활성화
IDO_KMS_ENABLED=false

# IDO_KMS_PROVIDER: KMS 구현체 선택 (IDO_KMS_ENABLED=true 시에만 유효)
#   vault → HashiCorp Vault Transit Engine ★ 표준 (온프레미스·클라우드 공통)
#   nhn   → NHN Cloud Secure Key Manager  (레거시 — 기존 NHN 운영 환경 유지)
#   noop  → NoOpKmsClient (Base64 패스스루, 명시적 테스트용)
IDO_KMS_PROVIDER=vault

# ── HashiCorp Vault 설정 (IDO_KMS_PROVIDER=vault 시 사용) ──────────────
# VAULT_ADDR: Vault 서버 주소
#   로컬: http://localhost:8200
#   K8s:  http://vault.vault.svc.cluster.local:8200
VAULT_ADDR=http://vault:8200

# VAULT_AUTH_METHOD: Vault 인증 방식
#   token      — 개발·단순 운영 (VAULT_TOKEN 환경변수 직접 사용)
#   approle    — CI/CD 파이프라인 (VAULT_ROLE_ID + VAULT_SECRET_ID)
#   kubernetes — K8s 운영 권장 (ServiceAccount JWT 자동 주입)
VAULT_AUTH_METHOD=token

# Token 인증 전용 (VAULT_AUTH_METHOD=token)
# 개발: docker-compose vault 서비스의 VAULT_DEV_ROOT_TOKEN_ID 값
# 운영: 절대 소스 코드·Git에 기재 금지 — K8s Secret으로만 주입
VAULT_TOKEN=dev-root-token

# AppRole 인증 전용 (VAULT_AUTH_METHOD=approle)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# K8s 인증 전용 (VAULT_AUTH_METHOD=kubernetes)
VAULT_K8S_ROLE=ido

# Transit 엔진 마운트 경로 및 키 이름 (기본값 그대로 사용 권장)
# VAULT_TRANSIT_PATH=transit
# VAULT_TRANSIT_KEY=ido-handoff-key

# ── NHN Cloud SKM 설정 (IDO_KMS_PROVIDER=nhn 시 사용, 레거시) ──────────
# NHN_SKM_APPKEY=
# NHN_SKM_AES_KEY_ID=
# NHN_SKM_HMAC_KEY_ID=
# NHN_SKM_MODE=secret

# ────────────────────────────────────────────────────────────
# [5] Q-IM CI/DI 암호화 키
# ────────────────────────────────────────────────────────────
# CI(연계정보) AES-256 암호화 키 v1 — 운영: KMS에서 주입
# 형식: 32바이트 base64 인코딩 (openssl rand -base64 32)
QIM_CI_AES_KEY_V1=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# CI 암호화 키 v2 — 키 로테이션 시 사용 (현재는 비워도 됨)
QIM_CI_AES_KEY_V2=

# 현재 활성 CI 키 버전 (v1 또는 v2)
QIM_CI_CURRENT_VERSION=v1

# DI(중복가입확인정보) 생성 비밀키
# 운영: 최소 32자 무작위 문자열 (openssl rand -hex 32)
QIM_DI_SECRET=default-di-secret-change-in-production

# ────────────────────────────────────────────────────────────
# [6] Webhook 서명 비밀키 (IdO → 기관 HTTPS Webhook)
# ────────────────────────────────────────────────────────────
# ido → 기관에게 HMAC-SHA256 서명된 webhook 발송 시 사용
# agency-stub 의 IDO_WEBHOOK_SIGNING_SECRET 와 동일한 값이어야 함
# 운영: openssl rand -hex 32
IDO_WEBHOOK_SIGNING_SECRET=poc-webhook-secret-change-in-production

# ────────────────────────────────────────────────────────────
# [7] Agency-Stub API 키 (기관 → IdO Verify API 인증)
# ────────────────────────────────────────────────────────────
# agency-stub 이 IdO /api/v1/verify 호출 시 사용하는 API Key
# IdO DB의 agency 테이블에 등록된 api_key 와 일치해야 함
AGENCY_API_KEY=stub-api-key-dev-001

# ────────────────────────────────────────────────────────────
# [8] Q-IM Inbound API Key Hash (Q-IM → IdO SP 역할 수신)
# ────────────────────────────────────────────────────────────
# IdO 가 Q-IM으로부터 SP 수신 API를 받을 때 검증하는 PBKDF2 해시
# 형식: pbkdf2:{iterations}:{saltBase64}:{hashBase64}
# 생성: infra/scripts/generate-api-key-hash.sh 스크립트 참고
# 미설정 시 모든 Q-IM SP 수신 API 요청이 거부됨
QIM_INBOUND_API_KEY_HASH=

# ────────────────────────────────────────────────────────────
# [9] Q-IM AES 공유키 (Q-IM ↔ IdO 데이터 암호화)
# ────────────────────────────────────────────────────────────
# Q-IM 팀과 암호화 스펙 협의 후 설정
# 운영: openssl rand -base64 32
QIM_AES_SHARED_KEY=

# ────────────────────────────────────────────────────────────
# [10] IdO 브로커 모드
# ────────────────────────────────────────────────────────────
# 허용값: qsign (기본) 또는 keycloak
# - qsign   : IdO가 Q-Sign에 인증 URL 발급 위임 (현재 운영 방식)
# - keycloak: IdO가 직접 Keycloak Authorization URL 생성 (신규 방식)
IDO_BROKER_MODE=qsign

# ────────────────────────────────────────────────────────────
# [11] CORS 허용 Origin
# ────────────────────────────────────────────────────────────
# React dev server (개발용)
CORS_ORIGIN_DEV=http://localhost:3000

# Nginx React (Option B 프로덕션)
CORS_ORIGIN_PROD=http://localhost:3001

# ────────────────────────────────────────────────────────────
# [12] Kafka 파티션/복제 설정 (환경별 오버라이드)
# ────────────────────────────────────────────────────────────
# PoC (단일 브로커): PARTITIONS_MAIN=12, RF=1, ISR=1
# 운영 (3-broker):  PARTITIONS_MAIN=12, RF=3, ISR=2
KAFKA_PARTITIONS_MAIN=12
KAFKA_PARTITIONS_DLQ=6
KAFKA_PARTITIONS_QIM=12
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1

# ────────────────────────────────────────────────────────────
# [13] Kafka Topic 이름 (운영 환경에서 네이밍 규칙 변경 시)
# ────────────────────────────────────────────────────────────
# 기본값은 create-topics.sh 및 각 서비스 application.yml 과 일치해야 함
# 변경 시 모든 서비스(q-sign, q-im, ido, agency-stub) 재배포 필요
#IDO_KAFKA_TOPIC_AUTH_EVENTS=qsign.auth.events
#QIM_SP_MEMBER_TOPIC=qim.sp.member.events

# ────────────────────────────────────────────────────────────
# [14] IdO Rate Limit 설정
# ────────────────────────────────────────────────────────────
IDO_RATE_LIMIT_ENABLED=true
IDO_RATE_LIMIT_DEFAULT_TPS=200
IDO_RATE_LIMIT_DEFAULT_DAILY=1000000

# ────────────────────────────────────────────────────────────
# [15] IdO Kafka 파티션 오버라이드 (운영 3-broker)
# ────────────────────────────────────────────────────────────
# 운영 시 아래 값으로 변경:
#   IDO_KAFKA_PARTITION_COUNT_MAIN=12
#   IDO_KAFKA_REPLICATION_FACTOR=3
#   IDO_KAFKA_MIN_INSYNC_REPLICAS=2
IDO_KAFKA_PARTITION_COUNT_MAIN=12
IDO_KAFKA_PARTITION_COUNT_DLQ=6
IDO_KAFKA_REPLICATION_FACTOR=1
IDO_KAFKA_MIN_INSYNC_REPLICAS=1

# ────────────────────────────────────────────────────────────
# [16] Q-IM Receiver Audit
# ────────────────────────────────────────────────────────────
# 운영: true 권장 (SP 수신 API 감사 로그 활성화)
QIM_RECEIVER_AUDIT=true

# ────────────────────────────────────────────────────────────
# [17] IdO 비동기 Executor 튜닝 (선택)
# ────────────────────────────────────────────────────────────
IDO_AUDIT_EXECUTOR_CORE=4
IDO_AUDIT_EXECUTOR_MAX=16
IDO_AUDIT_EXECUTOR_QUEUE=10000
IDO_WEBHOOK_EXECUTOR_CORE=4
IDO_WEBHOOK_EXECUTOR_MAX=20
IDO_WEBHOOK_EXECUTOR_QUEUE=5000

# ────────────────────────────────────────────────────────────
# [18] 플랫폼 메타 설정
# ────────────────────────────────────────────────────────────
IDO_PLATFORM_VERSION=1.0

# ────────────────────────────────────────────────────────────
# [19] OnePass Support 전용 PostgreSQL
# ────────────────────────────────────────────────────────────
# compose.support.yml 은 SSO/IM PostgreSQL과 분리된 전용 DB를 사용한다.
# 호스트 접속: localhost:${SUPPORT_POSTGRES_PORT}
# 컨테이너 접속: support-postgres:5432
SUPPORT_POSTGRES_PORT=5433
SUPPORT_POSTGRES_DB=onepass_support
SUPPORT_POSTGRES_USER=onepass_support
SUPPORT_POSTGRES_PASSWORD=onepass_support
SUPPORT_APP_PORT=8085

# ────────────────────────────────────────────────────────────
# [운영 배포 체크리스트]
# ────────────────────────────────────────────────────────────
# □ QIM_INTERNAL_API_KEY       → 32자 이상 무작위 값으로 교체
# □ QSIGN_KEYCLOAK_CLIENT_SECRET → Keycloak에서 재생성한 값으로 교체
# □ KEYCLOAK_CLIENT_SECRET     → Keycloak에서 재생성한 값으로 교체
# □ IDO_INTERNAL_SIG_SECRET    → 32자 이상 무작위 값으로 교체
# □ IDO_HANDOFF_AES_KEY        → openssl rand -base64 32 으로 생성
# □ IDO_HANDOFF_HMAC_KEY       → openssl rand -base64 32 으로 생성
# □ QIM_CI_AES_KEY_V1          → KMS에서 주입 또는 openssl rand -base64 32
# □ QIM_DI_SECRET              → 32자 이상 무작위 값으로 교체
# □ IDO_WEBHOOK_SIGNING_SECRET → 32자 이상 무작위 값으로 교체
# □ QIM_INBOUND_API_KEY_HASH   → generate-api-key-hash.sh 로 생성
# □ IDO_BROKER_MODE            → qsign 또는 keycloak (팀 협의 필요)
# □ KAFKA_REPLICATION_FACTOR   → 운영 3-broker 시 3으로 변경
# □ KAFKA_MIN_INSYNC_REPLICAS  → 운영 3-broker 시 2로 변경
