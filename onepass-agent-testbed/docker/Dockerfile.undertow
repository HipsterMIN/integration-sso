##############################################################################
# Undertow Standalone 테스트베드 — Unknown/GenericFilter Fallback 검증용
# WasDetector가 감지하지 못하는 WAS(UNKNOWN) 시나리오 시뮬레이션
##############################################################################
FROM eclipse-temurin:11-jre-jammy

LABEL description="OnePass Agent Testbed - Undertow (UNKNOWN Fallback 검증)"

RUN apt-get update && apt-get install -y curl wget && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Undertow standalone 실행을 위한 최소 구성
# 실제로는 onepass-agent-testbed/apps/undertow-sample 빌드 결과물 사용
RUN mkdir -p /app /agent /agent-config

VOLUME ["/agent", "/agent-config"]

# UNKNOWN 강제 지정 → GenericFilter Fallback 동작 검증
ENV JAVA_OPTS="-javaagent:/agent/onepass-agent-all.jar=/agent-config/onepass-agent.properties \
    -Donepass.was.type=UNKNOWN \
    -Xms128m -Xmx256m"

EXPOSE 8080

# 간단한 Undertow 서버 시뮬레이션 (echo 서버)
CMD ["sh", "-c", "echo 'UNKNOWN Fallback 테스트 환경 준비 완료' && sleep infinity"]
