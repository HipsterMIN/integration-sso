# ── 기본: 텍스트 파일은 LF로 정규화 ─────────────────────────────────────
* text=auto eol=lf

# ── 바이너리: CRLF 변환 절대 금지 ───────────────────────────────────────
*.jar        binary
*.war        binary
*.ear        binary
*.zip        binary
*.tar        binary
*.gz         binary
*.class      binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.svg        text eol=lf
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
*.pdf        binary
*.xlsx       binary
*.docx       binary

# ── Gradle wrapper — 반드시 바이너리 처리 ───────────────────────────────
gradle/wrapper/gradle-wrapper.jar binary
gradlew                            text eol=lf
gradlew.bat                        text eol=crlf

